# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- IDE / editor ----
.idea/
.vscode/

# ---- OS junk ----
.DS_Store
Thumbs.db

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Generated experiment artefacts ----
# Results (CSV) are produced by running the experiments; not tracked.
results/**/*.csv
results/*.csv
*.csv

# Figures are rendered at runtime (plt.show); if you save them, keep them out of git:
results/**/*.png
*.png

# ---- Kept on purpose ----
# Debug figures and tables referenced in docs/ (the project plan asks for them in git)
!docs/*.png
!docs/*.csv

# Summary tables of the full runs: small, and the lecturer checks the numbers without rerunning
!results/summary/*.csv

# Full time series of single runs and debug runs: large and reproducible from the seeds
results/series/
results/debug/
